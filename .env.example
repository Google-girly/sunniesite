# Copy this file to .env and fill in your own values.

# Postgres (e.g. a free Supabase project — Project Settings > Connect >
# ORMs > Prisma gives you both of these ready-made). DATABASE_URL is the
# pooled connection the running app uses; DIRECT_URL bypasses the pooler
# for `prisma migrate` (pooled connections don't support the session
# state migrations need). See README's Database section.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Random secret that signs the login session cookie — generate your own,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Each Member logs in with her own password (set by the President from
# Manage Officers & Logins) rather than one shared app password.
SESSION_SECRET="change-this-to-a-random-value"

# Meeting-minutes email reminders (Aug 2026) — sent by a daily cron job
# (see vercel.json + app/api/cron/meeting-reminders) to every Active
# member with an email on file, the day before each scheduled meeting.
# See lib/email.ts and lib/meetingReminders.ts for the full explanation.

# The chapter Gmail account these get sent from.
GMAIL_USER="chapter@gmail.com"
# An "App Password" for that account — NOT its normal login password.
# Generate one at myaccount.google.com/apppasswords (requires 2-Step
# Verification to be turned on for that account first).
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# This app's real deployed URL (no trailing slash) — used to build the
# "view the minutes" link inside the reminder email.
APP_BASE_URL="https://your-app.vercel.app"

# A random secret Vercel Cron sends back on every trigger so this route
# can tell a real cron request from anyone who finds the URL — generate
# your own the same way as SESSION_SECRET above, then add it as an env
# var in the Vercel project settings too (Vercel reads it and signs
# cron requests with it automatically once it's set there).
CRON_SECRET="change-this-to-a-random-value"

# The shared "chapter password" sisters enter on /signup (see
# app/api/auth/signup) to prove they're actually a chapter member before
# claiming her own account and setting her own real password — this is
# just the gate, not anyone's login password. Only lets her claim a
# Member row the President already added to the Roster and that doesn't
# have a password set yet; it can't create a brand-new roster entry.
SIGNUP_PASSWORD="change-this-to-your-chapter-password"

# Chapter Assistant (RAG chatbot, /api/chapter-assistant) — the free tier
# at console.groq.com, no credit card required. Only used for generation;
# embeddings run locally (see lib/rag/embed.ts), so this is the one
# outside call the whole feature makes.
GROQ_API_KEY=

# Chapter identity — see lib/chapterConfig.ts. Read client-side (sidebar,
# login page, dashboard, meeting-minutes exports/emails), hence the
# NEXT_PUBLIC_ prefix Next.js requires to bundle a var into browser code.
# Neither of these is a secret.
NEXT_PUBLIC_CHAPTER_ORG_NAME="Sigma Omega Nu"
NEXT_PUBLIC_CHAPTER_LABEL="Theta Chapter"

# The chapter's public, read-only Google Calendar id (Settings ->
# Integrate calendar -> Calendar ID on calendar.google.com). See
# lib/calendar.ts — this is only ever embedded as an <iframe src> the
# browser already sees, so it isn't a secret either.
NEXT_PUBLIC_CHAPTER_CALENDAR_ID=
